# Dev image for the Nuxt 3 frontend.
# Uses npm (lower memory footprint than pnpm) to install deps at build time
# so the container startup is fast and install never runs in a memory-limited container.
FROM node:22-alpine

WORKDIR /app

# Copy manifest first — Docker layer cache skips install on unrelated changes.
COPY package.json ./

# npm uses significantly less memory than pnpm during install.
RUN npm install --legacy-peer-deps

EXPOSE 3000

# Bind to 0.0.0.0 so the port is reachable outside the container.
CMD ["npm", "run", "dev"]
